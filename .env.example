# Hades AI LLM Configuration
# Copy this file to .env for local development. Never commit real API keys.

# OpenAI API
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Mistral AI API
# Get from: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434

# Runtime Python execution is disabled by default.
# Enable only inside a trusted local sandbox.
HADES_ENABLE_CODE_EXEC=0
